{
  "name": "@vitnode/forum",
  "version": "2.0.0-canary.13",
  "description": "Community forum for VitNode: structured forums and nested threads, built on the Content Engine.",
  "author": {
    "name": "VitNode",
    "email": "contact@vitnode.com",
    "url": "https://vitnode.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./locales/*.json": "./src/locales/*.json",
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build:plugins": "vitnode build",
    "dev": "vitnode dev",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@vitnode/core": "workspace:*",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "use-intl": "^4.14.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitnode/config": "workspace:*",
    "cn": "^0.5.2",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "postgres": "^4.1.0",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  }
}
