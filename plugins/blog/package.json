{
  "name": "@vitnode/blog",
  "version": "2.0.0-canary.13",
  "description": "Blog plugin for VitNode, providing a blogging platform on Hono.js.",
  "author": "VitNode Team",
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXenDeveloper/vitnode.git",
    "directory": "plugins/blog"
  },
  "keywords": [
    "vitnode",
    "react",
    "hono.js",
    "typescript",
    "blog"
  ],
  "type": "module",
  "exports": {
    "./locales/*.json": "./src/locales/*.json",
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build:plugins": "vitnode build",
    "dev": "vitnode dev",
    "dev:email": "email dev --dir src/emails",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.41",
    "@vitnode/core": "workspace:*",
    "ai": "^7.0.131",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "sonner": "^2.0.8",
    "use-intl": "^4.14.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-email/ui": "^6.11.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitnode/config": "workspace:*",
    "cn": "^0.4.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postgres": "^3.4.9",
    "tsc-alias": "^1.9.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
