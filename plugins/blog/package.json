{
  "name": "@vitnode/blog",
  "version": "2.0.0-canary.13",
  "description": "Blog plugin for VitNode, providing a blogging platform on Hono.js.",
  "author": {
    "name": "VitNode",
    "email": "contact@vitnode.com",
    "url": "https://vitnode.com"
  },
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXenDeveloper/vitnode.git",
    "directory": "plugins/blog"
  },
  "keywords": [
    "vitnode",
    "react",
    "hono.js",
    "typescript",
    "blog"
  ],
  "type": "module",
  "exports": {
    "./locales/*.json": "./src/locales/*.json",
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build:plugins": "vitnode build",
    "dev": "vitnode dev",
    "dev:email": "email dev --dir src/emails",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@vitnode/core": "workspace:*",
    "ai": "^7.0.164",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.8",
    "sonner": "^2.0.8",
    "use-intl": "^4.14.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@react-email/ui": "^6.11.8",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitnode/config": "workspace:*",
    "cn": "^0.5.2",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "postgres": "^4.1.0",
    "tsdown": "^0.23.7",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  }
}
