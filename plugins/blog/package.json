{
  "name": "@vitnode/blog",
  "version": "1.2.0-canary.56",
  "description": "Blog plugin for VitNode, providing a blogging platform with Next.js and Hono.js.",
  "author": "VitNode Team",
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXenDeveloper/vitnode.git",
    "directory": "plugins/blog"
  },
  "keywords": [
    "vitnode",
    "react",
    "hono.js",
    "next.js",
    "typescript",
    "blog"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build:plugins": "tsc && swc src -d dist --config-file .swcrc && tsc-alias -p tsconfig.json",
    "dev": "concurrently \"tsc -w --preserveWatchOutput\" \"swc src -d dist --config-file .swcrc -w\" \"tsc-alias -w\" \"vitnode plugin --w\"",
    "dev:email": "email dev --dir src/emails",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.3",
    "@vitnode/core": "workspace:*",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.9",
    "lucide-react": "^0.544.0",
    "next": "15.6.0-canary.41",
    "next-intl": "^4.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "^4.2.12",
    "react-hook-form": "^7.63.0",
    "sonner": "^2.0.7",
    "use-intl": "^4.3.9",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@react-email/components": "^0.5.5",
    "@swc/cli": "0.6.0",
    "@swc/core": "^1.13.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitnode/config": "workspace:*",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
