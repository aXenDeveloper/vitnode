{
  "name": "@vitnode/blog",
  "version": "1.2.0-canary.17",
  "description": "Blog plugin for VitNode, providing a blogging platform with Next.js and Hono.js.",
  "author": "VitNode Team",
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXenDeveloper/vitnode.git",
    "directory": "plugins/blog"
  },
  "keywords": [
    "vitnode",
    "react",
    "hono.js",
    "next.js",
    "typescript",
    "blog"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build:plugins": "tsc && swc src -d dist --config-file .swcrc && tsc-alias -p tsconfig.json",
    "dev": "concurrently \"tsc -w --preserveWatchOutput\" \"swc src -d dist --config-file .swcrc -w\" \"tsc-alias -w\" \"vitnode plugin --w\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.6",
    "@vitnode/core": "workspace:*",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.1",
    "hono": "^4.7.8",
    "lucide-react": "^0.513.0",
    "next": "^15.3.1",
    "next-intl": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "sonner": "^2.0.5",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@swc/cli": "0.6.0",
    "@swc/core": "^1.11.24",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "@vitnode/eslint-config": "workspace:*",
    "tsc-alias": "^1.8.15",
    "typescript": "^5.8.3"
  }
}
