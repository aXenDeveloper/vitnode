{
  "name": "@vitnode/blog",
  "version": "2.0.0-canary.1",
  "description": "Blog plugin for VitNode, providing a blogging platform on Hono.js.",
  "author": "VitNode Team",
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXenDeveloper/vitnode.git",
    "directory": "plugins/blog"
  },
  "keywords": [
    "vitnode",
    "react",
    "hono.js",
    "typescript",
    "blog"
  ],
  "type": "module",
  "exports": {
    "./locales/*.json": "./src/locales/*.json",
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build:plugins": "vitnode build",
    "dev": "vitnode dev",
    "dev:email": "email dev --dir src/emails",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "vitest run --typecheck.only"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@vitnode/core": "workspace:*",
    "ai": "^7.0.37",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.12.31",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.0",
    "react-hook-form": "^7.82.0",
    "sonner": "^2.0.7",
    "use-intl": "^4.13.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitnode/config": "workspace:*",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "postgres": "^3.4.9",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
