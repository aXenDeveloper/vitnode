{
  "name": "@vitnode/blog",
  "version": "1.2.0-canary.78",
  "description": "Blog plugin for VitNode, providing a blogging platform with Next.js and Hono.js.",
  "author": "VitNode Team",
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXenDeveloper/vitnode.git",
    "directory": "plugins/blog"
  },
  "keywords": [
    "vitnode",
    "react",
    "hono.js",
    "next.js",
    "typescript",
    "blog"
  ],
  "type": "module",
  "exports": {
    "./locales/*.json": "./src/locales/*.json",
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build:plugins": "vitnode build",
    "dev": "vitnode dev",
    "dev:email": "email dev --dir src/emails",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@vitnode/core": "workspace:*",
    "ai": "^7.0.37",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "lucide-react": "^1.25.0",
    "next": "16.3.0-preview.9",
    "next-intl": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.0",
    "react-hook-form": "^7.82.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitnode/config": "workspace:*",
    "eslint": "^10.7.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3"
  }
}
