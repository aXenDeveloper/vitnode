{
  "name": "@vitnode/blog",
  "version": "1.2.0-canary.51",
  "description": "Blog plugin for VitNode, providing a blogging platform with Next.js and Hono.js.",
  "author": "VitNode Team",
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXenDeveloper/vitnode.git",
    "directory": "plugins/blog"
  },
  "keywords": [
    "vitnode",
    "react",
    "hono.js",
    "next.js",
    "typescript",
    "blog"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build:plugins": "tsc && swc src -d dist --config-file .swcrc && tsc-alias -p tsconfig.json",
    "dev": "concurrently \"tsc -w --preserveWatchOutput\" \"swc src -d dist --config-file .swcrc -w\" \"tsc-alias -w\" \"vitnode plugin --w\"",
    "dev:email": "email dev --dir src/emails",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.0.2",
    "@vitnode/core": "workspace:*",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "hono": "^4.8.10",
    "lucide-react": "^0.526.0",
    "next": "^15.4.5",
    "next-intl": "^4.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-email": "^4.2.7",
    "react-hook-form": "^7.61.1",
    "sonner": "^2.0.6",
    "use-intl": "^4.3.4",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@react-email/components": "^0.4.0",
    "@swc/cli": "0.6.0",
    "@swc/core": "^1.13.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitnode/eslint-config": "workspace:*",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2"
  }
}
