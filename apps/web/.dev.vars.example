# Secrets for `pnpm preview:cloudflare` (wrangler dev). Copy to `.dev.vars`;
# never commit it. In production set each with `wrangler secret put <NAME>`.
POSTGRES_URL=postgresql://root:root@127.0.0.1:5432/vitnode
VITNODE_WEB_URL=http://localhost:8787
CRON_SECRET=your-secure-cron-secret-key
# Optional
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
