{
  "name": "web",
  "version": "2.0.0-canary.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter api db:prepare && vitnode dev --port 3000",
    "build": "vitnode build",
    "build:cloudflare": "NITRO_PRESET=cloudflare-module vitnode build",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .output/wrangler-dry-run",
    "deploy:cloudflare": "wrangler deploy",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "check": "oxfmt --check .",
    "start": "vitnode start",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "node --test src/tests/*.test.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.7",
    "@vitnode/api": "workspace:*",
    "@vitnode/blog": "workspace:*",
    "@vitnode/core": "workspace:*",
    "@vitnode/forum": "workspace:*",
    "@vitnode/stripe": "workspace:*",
    "@vitnode/supabase-storage": "workspace:*",
    "d3-shape": "^3.2.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "1.0.0-rc.6",
    "drizzle-orm": "1.0.0-rc.6",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.7",
    "hono": "^4.13.20",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "newsroom": "workspace:*",
    "nitro": "3.0.261103-rc",
    "payments-demo": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "use-intl": "^4.15.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/router-cli": "^1.168.0",
    "@types/d3-shape": "^3.2.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitnode/config": "workspace:*",
    "cn": "^0.5.2",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
