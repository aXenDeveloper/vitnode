POSTGRES_URL=postgresql://root:root@localhost:5432/vitnode
REDIS_URL=redis://localhost:6379

# This app serves its own API at `/api/*`, so both name the same origin - and it
# has to be the port `pnpm dev` actually serves (`vite dev --port 3000`). Point
# either of them somewhere else and the browser talks to whatever is there
# instead of the API mounted in this process.
#
# Neither side strictly needs them: `resolveApiOrigin()` in
# `src/server/fetcher.server.ts` takes the origin off the request being
# rendered, and in the browser `CONFIG.api` falls back to the origin the page
# was served from - so a preview deployment on a generated hostname needs no
# config at all. Set `VITNODE_API_URL` only to point at a separate API
# server; `VITNODE_WEB_URL` is still what the API stamps cookies with.
VITNODE_WEB_URL=http://localhost:3000
VITNODE_API_URL=http://localhost:3000

# === Passkeys (WebAuthn) ===
# Off unless `authorization.passkeys` is set in `vitnode.api.config.ts`.
# Passkeys are bound to a domain (the RP ID) and only work on the origins listed
# in `authorization.passkeys.origins` - here, `VITNODE_WEB_URL`. Browsers allow
# them on HTTPS or on localhost. Leave the RP ID unset to use the hostname of
# `VITNODE_WEB_URL`; set it to a parent domain (e.g. `example.com`) to share
# passkeys between `example.com` and `forum.example.com`. Changing it later
# makes every existing passkey unusable.
# VITNODE_PASSKEY_RP_ID=localhost

# === CRON Secret for Internal API Calls ===
CRON_SECRET=your-secure-cron-secret-key

# === Docker Database Postgres ===
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_NAME=vitnode

# === Docker Redis ===
REDIS_PASSWORD=root
