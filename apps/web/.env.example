POSTGRES_URL=postgresql://root:root@localhost:5432/vitnode
REDIS_URL=redis://localhost:6379

# This app serves its own API at `/api/*`, so both point at the same origin.
# `@vitnode/core`'s fetcher builds absolute URLs from `NEXT_PUBLIC_API_URL`;
# leaving it equal to the web origin is what keeps API access same-origin.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# === CRON Secret for Internal API Calls ===
CRON_SECRET=your-secure-cron-secret-key

# === Docker Database Postgres ===
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_NAME=vitnode

# === Docker Redis ===
REDIS_PASSWORD=root
