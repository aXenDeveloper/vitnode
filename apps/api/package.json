    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitnode/blog": "workspace:*",
    "@vitnode/example": "workspace:*",
    "@vitnode/config": "workspace:*",
    "@vitnode/nodemailer": "workspace:*",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "react-email": "^6.9.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
