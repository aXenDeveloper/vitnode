    "@hono/zod-validator": "^0.7.2",
    "@react-email/components": "^0.3.2",
    "@vitnode/core": "workspace:*",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.3",
    "hono": "^4.8.5",
    "next-intl": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@hono/node-server": "^1.17.1",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitnode/eslint-config": "workspace:*",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "react-email": "^4.2.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
