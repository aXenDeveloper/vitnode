{
  "name": "vitnode",
  "private": true,
  "scripts": {
    "release": "tsx ./scripts/bump-version/bump-version.ts",
    "db:migrate": "turbo db:migrate",
    "docker:dev": "turbo docker:dev",
    "build:scripts": "turbo build:scripts && pnpm i",
    "build:plugins": "turbo build:plugins",
    "build": "turbo build",
    "start": "turbo start",
    "init": "turbo init",
    "dev": "pnpm build:scripts && turbo build:plugins && turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@vitnode/config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.22.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ]
}
