{
  "name": "vitnode",
  "private": true,
  "scripts": {
    "release": "tsx ./scripts/bump-version/bump-version.ts",
    "db:migrate": "turbo db:migrate",
    "docker:dev": "turbo docker:dev",
    "build:scripts": "turbo build:scripts && pnpm i",
    "build:plugins": "turbo build:plugins",
    "build": "turbo build",
    "start": "turbo start",
    "init": "turbo init",
    "dev": "pnpm build:scripts && turbo build:plugins && turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@vitnode/config": "workspace:*",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ]
}
