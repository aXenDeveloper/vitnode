{
  "name": "vitnode",
  "private": true,
  "scripts": {
    "release": "tsx ./scripts/bump-version.ts",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "docker:dev": "docker compose -f ./docker-compose.yml -p vitnode-dev-dun up -d",
    "build:scripts": "turbo build:scripts && pnpm i",
    "build:plugins": "turbo build:plugins",
    "build": "turbo build",
    "start": "turbo start",
    "init": "turbo init",
    "dev": "pnpm build:scripts && turbo build:plugins && turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "@vitnode/eslint-config": "workspace:*",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ]
}
