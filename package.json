{
  "name": "vitnode",
  "private": true,
  "scripts": {
    "release": "tsx ./scripts/bump-version/bump-version.ts",
    "db:migrate": "turbo db:migrate",
    "db:prepare": "turbo db:prepare",
    "docker:dev": "turbo docker:dev",
    "build:scripts": "turbo build:scripts && pnpm i",
    "build:plugins": "turbo build:plugins",
    "build": "turbo build",
    "start": "turbo start",
    "dev": "pnpm build:scripts && turbo build:plugins && turbo db:prepare && turbo dev",
    "lint": "turbo lint && pnpm format:check",
    "lint:fix": "turbo lint:fix && pnpm format",
    "format": "oxfmt \"**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}\"",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}\"",
    "test": "turbo test",
    "test:types": "turbo test:types",
    "i18n:create": "cd apps/api && pnpm run i18n:create",
    "i18n:check": "cd apps/api && pnpm run i18n:check",
    "i18n:delete": "cd apps/api && pnpm run i18n:delete",
    "i18n:update": "cd apps/api && pnpm run i18n:update",
    "i18n:update:ai": "cd apps/api && pnpm run i18n:update:ai",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitnode/config": "workspace:*",
    "oxfmt": "^0.72.0",
    "react-doctor": "^0.9.17",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ]
}
