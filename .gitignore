# Dependencies
node_modules

# Turbo
.turbo

# Local env files
# Every mode Vite loads (`.env.production`, `.env.staging.local`, ...) - only
# the example file is committed.
.env*
!.env.example

# Build Outputs
out/
build
dist

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Others
# Ignore local docker data dirs (e.g. docker/dev) but keep image build context.
/docker/*
!/docker/postgres
.vercel
# next-agents-md
.next-docs/
