{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "test": {
      "cache": false
    },
    "test:types": {
      "dependsOn": ["^test:types"],
      "cache": false
    },
    "docker:dev": {
      "dependsOn": ["^docker:dev"],
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["POSTGRES_URL", "VITNODE_API_URL", "VITNODE_WEB_URL"]
    },
    "db:prepare": {
      "dependsOn": ["^build:plugins"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["POSTGRES_URL"]
    },
    "db:migrate": {
      "dependsOn": ["^db:migrate"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["POSTGRES_URL"]
    },
    "build:plugins": {
      "dependsOn": ["^build:plugins", "@vitnode/core#build:scripts"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": ["^build:plugins", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", ".vercel/output/**", "dist/**"],
      "env": ["POSTGRES_URL", "VITNODE_API_URL", "VITNODE_WEB_URL"]
    },
    "build:scripts": {
      "dependsOn": ["^build:scripts"],
      "cache": false,
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["POSTGRES_URL", "VITNODE_API_URL", "VITNODE_WEB_URL"]
    },
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "start": {
      "dependsOn": ["^start"]
    }
  }
}
