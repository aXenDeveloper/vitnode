{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "test": {
      "dependsOn": ["^test"],
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["^db:migrate"],
      "cache": false
    },
    "db:push": {
      "dependsOn": ["^db:push"],
      "cache": false,
      "env": [
        "POSTGRES_URL",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "POSTGRES_NAME",
        "POSTGRES_SSL"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "LOGIN_TOKEN_SECRET",
        "POSTGRES_URL",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "POSTGRES_NAME",
        "POSTGRES_SSL"
      ]
    },
    "build:scripts": {
      "dependsOn": ["^build:scripts"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "LOGIN_TOKEN_SECRET",
        "POSTGRES_URL",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "POSTGRES_NAME",
        "POSTGRES_SSL"
      ]
    },
    "start": {
      "dependsOn": ["^start"]
    }
  }
}
