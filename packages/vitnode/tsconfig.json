{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vitnode/config/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "./",
    "outDir": "./dist",
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": [
    "src",
    "scripts",
    "src/emails",
    "vitest.config.ts",
    "tsup.config.ts",
    "global.d.ts"
  ]
}
