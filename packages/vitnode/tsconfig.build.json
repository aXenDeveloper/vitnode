{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true
  },
  "exclude": [
    "node_modules",
    "src/tests",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-d.ts"
  ],
  "include": ["src", "global.d.ts"]
}
