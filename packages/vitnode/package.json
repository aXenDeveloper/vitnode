      "types": "./dist/src/tanstack/*/index.d.ts",
      "default": "./dist/src/tanstack/*/index.js"
    },
    "./tanstack/*/client": {
      "import": "./dist/src/tanstack/*/client.js",
      "types": "./dist/src/tanstack/*/client.d.ts",
      "default": "./dist/src/tanstack/*/client.js"
