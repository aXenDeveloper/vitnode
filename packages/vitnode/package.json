    "next": "^16.0.x",
    "next-intl": "^4.x.x",
    "react": "^19.2.x",
    "react-dom": "^19.2.x",
    "react-hook-form": "^7.x.x",
    "tsdown": "^0.22.4",
    "typescript": "^5.9.x",
    "zod": "^4.x.x"
  },
  "devDependencies": {
