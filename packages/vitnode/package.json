    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "zod": "^4.4.3"
  },
  "bin": {
    "vitnode": "./dist/scripts/scripts.js"
  },
  "exports": {
    "./api/config": {
      "import": "./dist/src/api/config.js",
      "types": "./dist/src/api/config.d.ts",
      "default": "./dist/src/api/config.js"
    },
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./config/next.config": "./config/next.config.ts",
    "./locales/en.json": "./src/locales/en.json",
    "./styles/tiptap.css": "./src/tiptap.css"
  },
  "scripts": {
    "build:scripts": "tsup",
    "start:scripts": "node dist/scripts/scripts.js init",
    "build:plugins": "tsdown",
    "dev": "concurrently \"tsdown --watch\" \"node dist/scripts/scripts.js plugin --w\"",
    "dev:email": "email dev --dir src/emails",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bprogress/next": "^3.2.12",
