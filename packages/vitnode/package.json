      "default": "./dist/src/tanstack/*/server.js"
    },
    "./*": {
      "import": "./dist/src/*.js",
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./locales/*.json": "./src/locales/*.json",
    "./styles/tiptap.css": "./src/tiptap.css",
    "./styles/view-transitions.css": "./src/view-transitions.css"
  },
  "scripts": {
    "build:scripts": "tsup",
    "start:scripts": "node dist/scripts/scripts.js db:prepare",
    "build:plugins": "tsc -p tsconfig.build.json && swc src -d dist --config-file .swcrc --copy-files && tsc-alias -p tsconfig.build.json",
    "dev": "node dist/scripts/scripts.js dev",
    "dev:email": "email dev --dir src/emails",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck.only",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
