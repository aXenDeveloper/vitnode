{
  "name": "vitnode-backend",
  "version": "0.0.10-canary.27",
  "description": "Backend wrapper for VitNode projects",
  "author": "VitNode Team",
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitNode/vitnode.git",
    "directory": "packages/backend"
  },
  "bin": {
    "vitnode-backend": "dist/scripts/setup.js"
  },
  "scripts": {
    "build": "tsc && swc src -d dist --config-file .swcrc",
    "build:scripts": "tsup",
    "dev": "concurrently \"tsc -w --preserveWatchOutput\" \"swc src -d dist --config-file .swcrc -w\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./main": {
      "require": "./dist/src/main.js",
      "types": "./dist/src/main.d.ts"
    },
    "./providers/*": {
      "require": "./dist/src/providers/*.js",
      "types": "./dist/src/providers/*.d.ts"
    },
    "./utils/*": {
      "require": "./dist/src/utils/*.js",
      "types": "./dist/src/utils/*.d.ts"
    },
    "./helpers/*": {
      "require": "./dist/src/helpers/*.js",
      "types": "./dist/src/helpers/*.d.ts"
    },
    "./guards/*": {
      "require": "./dist/src/guards/*.js",
      "types": "./dist/src/guards/*.d.ts"
    },
    "./functions/*": {
      "require": "./dist/src/functions/*.js",
      "types": "./dist/src/functions/*.d.ts"
    },
    "./app.module": {
      "require": "./dist/src/app.module.js",
      "types": "./dist/src/app.module.d.ts"
    }
  },
  "keywords": [
    "vitnode",
    "nestjs",
    "nest.js",
    "nest",
    "drizzle",
    "typescript",
    "appollo",
    "serve-static",
    "react-email",
    "swc",
    "sharp",
    "pg",
    "postgresql",
    "express",
    "codegen"
  ],
  "peerDependencies": {
    "@nestjs/common": "^10.4.13",
    "@nestjs/core": "^10.4.13",
    "@nestjs/platform-express": "^10.4.13",
    "@nestjs/schedule": "^4.1.1",
    "@react-email/components": "^0.0.29",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.13",
    "@nestjs/core": "^10.4.13",
    "@nestjs/platform-express": "^10.4.13",
    "@nestjs/schedule": "^4.1.1",
    "@react-email/components": "^0.0.29",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.10.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/ua-parser-js": "^0.7.39",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.29.1",
    "drizzle-orm": "^0.37.0",
    "eslint-config-typescript-vitnode": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@nestjs/config": "^3.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^8.1.0",
    "@react-email/render": "^1.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "tar": "^7.4.3",
    "ua-parser-js": "^2.0.0",
    "vitnode-shared": "workspace:*"
  }
}
