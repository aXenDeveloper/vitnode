    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "drizzle-orm": "^0.37.0",
    "hono": "^4.6.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.0",
    "dotenv": "^16.4.7",
