    "./biome": {
      "import": "./biome.json",
      "default": "./biome.json"
    }
  },
  "peerDependencies": {
    "typescript": "5.9.x"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "typescript": "^5.9.2"
  }
