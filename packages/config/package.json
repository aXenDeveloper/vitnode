{
  "name": "@vitnode/config",
  "version": "2.0.0-canary.13",
  "description": "Oxlint, Oxfmt, TypeScript (TSConfig) config for VitNode",
  "author": "VitNode Team",
  "license": "MIT",
  "homepage": "https://vitnode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXenDeveloper/vitnode.git",
    "directory": "packages/config"
  },
  "keywords": [
    "vitnode",
    "typescript",
    "tsconfig",
    "oxlint",
    "oxfmt"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./oxlint.config.d.mts",
      "import": "./oxlint.config.mjs",
      "default": "./oxlint.config.mjs"
    },
    "./oxlint.react": {
      "types": "./oxlint.react.config.d.mts",
      "import": "./oxlint.react.config.mjs",
      "default": "./oxlint.react.config.mjs"
    },
    "./tsconfig": {
      "import": "./tsconfig.json",
      "default": "./tsconfig.json"
    },
    "./oxfmt": {
      "types": "./oxfmt.config.d.mts",
      "import": "./oxfmt.config.mjs",
      "default": "./oxfmt.config.mjs"
    }
  },
  "peerDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "6.0.x"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.24.8",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.2"
  }
}
