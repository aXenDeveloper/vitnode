    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitnode/config": "workspace:*",
    "oxlint": "^1.92.0",
