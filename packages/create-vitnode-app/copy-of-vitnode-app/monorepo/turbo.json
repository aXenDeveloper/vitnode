{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "db:prepare": {
      "dependsOn": ["^build:plugins"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["POSTGRES_URL"]
    },
    "db:migrate": {
      "dependsOn": ["^db:migrate"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["POSTGRES_URL"]
    },
    "build:plugins": {
      "dependsOn": ["^build:plugins"],
      "outputs": ["dist/**"]
    },
    "build": {
      "dependsOn": ["^build:plugins", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"],
      "env": ["POSTGRES_URL", "VITNODE_API_URL", "VITNODE_WEB_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["POSTGRES_URL", "VITNODE_API_URL", "VITNODE_WEB_URL"]
    },
    "start": {
      "dependsOn": ["^start"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "i18n:create": {
      "dependsOn": ["^i18n:create"]
    },
    "i18n:check": {
      "dependsOn": ["^i18n:check"]
    },
    "i18n:delete": {
      "dependsOn": ["^i18n:delete"]
    },
    "i18n:update": {
      "dependsOn": ["^i18n:update"]
    },
    "i18n:update:ai": {
      "dependsOn": ["^i18n:update:ai"]
    }
  }
}
