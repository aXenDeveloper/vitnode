{
  // Nitro merges this file into `.output/server/wrangler.json` and adds `main`
  // and `assets`; Wrangler finds that file on its own through
  // `.wrangler/deploy/config.json`, and reads `.dev.vars` from this folder.
  "name": "{{WORKER_NAME}}",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      // The realtime hub that owns every WebSocket. The binding name is fixed.
      { "name": "VITNODE_REALTIME", "class_name": "VitNodeRealtimeHub" }
    ]
  },
  // SQLite-backed, so the hub keeps its rooms while it hibernates.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VitNodeRealtimeHub"] }],
  "vars": {
    "VITNODE_INSTALLATION_ID": "default"
    // Optional: "VITNODE_REALTIME_SHARDS": "4" spreads sockets across four
    // hubs; "VITNODE_REALTIME_HIBERNATION": "false" keeps the hub awake.
  },
  "observability": { "enabled": true }
}
